//- module
@import '../vars.styl'
@import '../basic.styl'

body.editing
  overflow: hidden

#editor
  .col-6, .col-4, .col-12
    margin-bottom: 10px
  label
    text-transform: capitalize
    width: 100%
    display: inline-block
    text-overflow: ellipsis
    white-space: nowrap
    overflow: hidden
  // collapsed bar shows the first row of options ( text / font / size / background ).
  // at the 18px root font size ( labels at .9em, line-height 1.2 ) that row ends at 71px; the bar's height has to follow it
  position: fixed
  top: -84px
  left: 0
  width: 100%
  height: 84px
  z-index: index(order, 'editor')
  background: unquote('url(data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxMCIgaGVpZ2h0PSIxMCIgdmlld0JveD0iMCAwIDEwIDEwIj48cGF0aCBkPSJNLTEwIC0xMEwyMCAyME0tMjAgLTEwTDEwIDIwTS0xMCAtMjBMMjAgMTAiIHN0cm9rZT0iI2ZhZmJmYyIgc3Ryb2tlLXdpZHRoPSIxIi8+PC9zdmc+)') #fff
  padding: 0 0 10px
  overflow: hidden
  box-shadow: 0 1px 2px rgba(0,0,0,.2)
  transition: all 0.3s ease-in-out
  .config
    padding: 10px 0 0
    border-bottom: 1px solid #ccc
    background: rgba(255,255,255,.6)
  .footer
    padding: 30px 0
    background: rgba(255,255,255,.6)
    border-top: 1px solid #ccc
    position: fixed
    z-index: -1
    opacity: 0
    width: 100%
    bottom: -100px
    transition: all 0.3s ease-in-out
    .btn-group
      width: 300px
      .btn
        flex-grow: 1
  // label 與輸入框之間不留行距 ( 根字級 18px, 預設 1.5 行高會空出一截 )
  label
    margin-bottom: 0
    line-height: 1.2
    font-size: .9em
  &.on
    top: 0
  .empty
    width: 100%
    height: 100%
    text-align: center
    color: #999
    display: table
    &:after
      content: "no custom options"
      display: table-cell
      vertical-align: middle

@media(max-width: 576px)
  #editor
    top: -150px
    height: 150px


#cooltext
  width: 100%
  //-width: 600px
  height: 170px
  position: absolute
  z-index: -1
  top: 50%
  left: 50%
  transform: translate(-50%,-50%)
  opacity: 0
  transition: opacity 0.3s ease-in-out

#cooltext svg
  display: block
  margin: auto
  //-width: 600px
  width: 100%

body.editing
  #editor
    height: 100%
    top: 0
  .gallery .item svg
    visibility: hidden
  #editor
    .footer
      opacity: 1
      z-index: 1
      bottom: 0
      position: fixed
  #cooltext
    opacity: 1
    position: fixed

.full-picker > .inner
  position: fixed
  width: 90%
  height: 90%
  top: 0
  left: 0
  right: 0
  bottom: 0
  margin: auto
  background: #fff

// 彈出式色盤 ( @loadingio/ldcolorpicker ) 要蓋在 #editor 之上
.ldcolorpicker.bubble
  z-index: index(order, 'ldcp')

#svg-work-area
  overflow: hidden
  height: 1px
  width: 0

#download.modal .card
  centered()
  width: 90%
  max-width: 640px
  // follows its content ( a fixed 380px clipped the buttons once the font got larger );
  // with inset 0 and margin auto it stays centered
  height: fit-content
  text-align: center
  .result
    margin: 1em auto
    // 預覽縮到對話框內 ( 下載的檔案仍是原尺寸 ). 字大時圖會比對話框大很多
    img
      display: block
      margin: auto
      max-width: 100%
      max-height: 50vh
      box-shadow: 0 1px 3px rgba(0,0,0,.2)


// 匯出設定 ( src/ls/editor/layout.ls ): padding 與倍率, 放在下載按鈕左邊
#editor .footer
  .inline-block
    vertical-align: bottom
  .mt-export-opt .form-control
    width: 90px
  .mt-drag-hint
    margin-top: 8px
    font-size: 12px
    color: #999
// 編輯時可拖曳文字微調位置; 虛線框是匯出範圍
body.editing #cooltext
  cursor: grab
  touch-action: none
  &.dragging
    cursor: grabbing
#cooltext .mt-crop
  fill: none
  stroke: rgba(120,120,120,.8)
  stroke-dasharray: 4 4
  vector-effect: non-scaling-stroke
  pointer-events: none

// 圖樣填色 ( src/ls/editor/pattern.ls ): fill 顏色欄位右邊的按鈕, 與選單
#editor .color
  position: relative
  .mt-pattern-btn
    position: absolute
    top: 3px
    right: 14px
    width: 22px
    height: calc(100% - 6px)
    border: 1px dashed #999
    border-radius: 3px
    background: #fff center / 22px repeat
    cursor: pointer
    z-index: 1
    &:after
      content: "▦"
      display: block
      text-align: center
      font-size: 12px
      line-height: 1.6
      color: #999
    &.active
      border: 1px solid #333
      &:after
        content: ""
#pattern-picker .base
  width: 480px
  max-width: 95vw
  .mt-pattern-grid
    display: grid
    grid-template-columns: repeat(4, 1fr)
    gap: 8px
  .mt-pattern-item
    height: 72px
    border-radius: 4px
    border: 1px solid #ddd
    background: center / 48px repeat
    cursor: pointer
    &:hover
      border-color: #333
    &.none
      display: flex
      align-items: center
      justify-content: center
      color: #999
