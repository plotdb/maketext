// 字型選擇器 ( @xlfont/choose ) 的全頁遮罩與面板, 由 src/ls/editor/font.ls 建立
// 不開「上傳自己的字型」: 下載時要從 xlfont 取字形外框 ( download.ls )
.mt-xfc-overlay
  position: fixed
  top: 0
  left: 0
  right: 0
  bottom: 0
  z-index: 1050
  display: flex
  align-items: center
  justify-content: center
  background: rgba(0,0,0,.5)
.mt-xfc-panel
  width: 760px
  max-width: 92vw
  height: 560px
  max-height: 82vh
  background: #fff
  border-radius: .5em
  box-shadow: 0 .5em 2em rgba(0,0,0,.4)
  overflow: hidden
  display: flex
  flex-direction: column
  .xfc
    flex: 1 1 auto
    min-height: 0
  .xfc-head .text-nowrap
    display: none !important
