//- module
@import '../vars.styl'
@import '../basic.styl'

.color
  position: relative
  .inner
    background: #f00
    width: 5px
    height: 21px
    position: absolute
    top: 5px
    right: 5px
    border-radius: 5px

.palette
  cursor: pointer
  width: 100%
  height: 32px
  flexbox()
  flex-wrap(nowrap)
  panel()
  padding: 3px
  overflow: hidden
  .color
    height: 100%
    flex(1 1 auto)
    background: #f00
  .color:first-child, .name + .color
    border-radius: 3px 0 0 3px
  .color:last-child
    border-radius: 0 3px 3px 0

// 色盤選擇器 ( ldpalettepicker ), 由 src/ls/editor/palette.ls 建立
// 沒有使用者帳號, 不提供「my pals」與儲存
#palette-picker
  [data-panel=mypal], [data-action=save]
    display: none !important
