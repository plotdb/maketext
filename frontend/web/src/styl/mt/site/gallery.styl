//- module
@import '../vars.styl'
@import '../basic.styl'

.gallery
  max-width: 1024px
  width: 90%
  margin: auto
  outline: none
  .item
    position: relative
    cursor: pointer
    z-index: 0
    flex(1 1 auto)
    panel()
    margin: 10px
    padding: 0px
    overflow: hidden
    &:after
      content: " "
      display: block
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
    .inner
      width: 100%
      height: 100%
    svg
      will-change: transform, opacity
    // 預設顯示縮圖, .live 時才顯示即時 render 的 svg ( src/ls/editor/index.ls 的 gallery )
    .thumb
      display: block
      width: 100%
      height: 100%
      object-fit: contain
    svg
      display: none
    &.live
      .thumb
        display: none
      svg
        display: block
  .line
    height: 180px
    justify-content: center
  .item
    max-width: 490px
    width: 490px
    height: 160px

@media(max-width: 1200px)
  .gallery
    .item
      max-width: 400px
      width: 400px

@media(max-width: 991px)
  .gallery
    .item
      max-width: 300px
      width: 300px

@media(max-width:768px)
  .gallery
    .line
      height: auto
    .item
      max-width: 490px
      height: 160px

// 各效果獨立頁的連結 ( src/ls/editor/index.ls ), 滑過格子時出現; 要在 .item:after 的遮罩之上才點得到
.gallery .item .mt-effect-link
  position: absolute
  top: 4px
  right: 8px
  z-index: 2
  font-size: 16px
  line-height: 1
  padding: 4px
  color: #999
  text-decoration: none
  opacity: 0
  transition: opacity .2s ease-in-out
.gallery .item:hover .mt-effect-link
  opacity: 1
