//- module
@import '../vars.styl'
@import '../basic.styl'

.gallery
  max-width: 1024px
  width: 90%
  margin: auto
  outline: none
  .item
    position: relative
    cursor: pointer
    z-index: 0
    flex(1 1 auto)
    panel()
    margin: 10px
    padding: 0px
    overflow: hidden
    &:after
      content: " "
      display: block
      position: absolute
      top: 0
      left: 0
      width: 100%
      height: 100%
    .inner
      width: 100%
      height: 100%
    svg
      will-change: transform, opacity
    // 預設顯示縮圖, .live 時才顯示即時 render 的 svg ( src/ls/editor/index.ls 的 gallery )
    .thumb
      display: block
      width: 100%
      height: 100%
      object-fit: contain
    svg
      display: none
    &.live
      .thumb
        display: none
      svg
        display: block
  // 每行的個數由 src/ls/editor/index.ls 的 gallery.cols 決定 ( .c3 / .c2 / .c1 )
  .line
    height: 180px
    justify-content: center
    flex-wrap: nowrap
  // basic.styl 有 flex() mixin, 寫 flex: 會被它吃掉參數, 分開寫
  .item
    flex-grow: 0
    flex-shrink: 0
    flex-basis: auto
    height: 160px
  .line.c3
    height: 160px
    .item
      width: calc(33.333% - 20px)
      height: 140px
  .line.c2 .item
    width: calc(50% - 20px)
  .line.c1
    height: auto
    .item
      width: 100%
      max-width: 490px
      height: 140px

// 各效果獨立頁的連結 ( src/ls/editor/index.ls ) 與收藏 ( star.ls ), 滑過格子時出現;
// 要在 .item:after 的遮罩之上才點得到. 已收藏的星號由 star.ls 產生的 css 標成金色並常駐
.gallery .item
  .mt-effect-link, .mt-star
    position: absolute
    top: 4px
    z-index: 2
    font-size: 18px
    line-height: 1
    padding: 4px
    color: #999
    text-decoration: none
    opacity: 0
    transition: opacity .2s ease-in-out
  .mt-effect-link
    right: 8px
  .mt-star
    right: 34px
    &:hover
      color: #f5b301
  &:hover
    .mt-effect-link, .mt-star
      opacity: 1
// 觸控裝置沒有 hover, 一直顯示
@media (hover: none)
  .gallery .item
    .mt-effect-link, .mt-star
      opacity: .8

// 效果編號
.gallery .item .mt-effect-no
  position: absolute
  left: 8px
  bottom: 4px
  z-index: 2
  font-size: 12px
  color: #999
  opacity: .7
  pointer-events: none

// 全部 / 收藏的篩選 ( landing.pug ): 捲過時 ( .fixed, src/ls/editor/star.ls ) 固定在收合的編輯列
// ( #editor.on, 高 84px; 窄螢幕 150px ) 下方. body 的高度是視窗高, position: sticky 黏不住
.mt-star-filter-wrap
  height: 51px
  margin-top: 12px
.mt-star-filter
  padding: 8px 0
  pointer-events: none
  &.fixed
    position: fixed
    top: 84px
    left: 0
    right: 0
    z-index: 5
  .btn-group
    pointer-events: auto
    box-shadow: 0 1px 4px rgba(0,0,0,.12)
    border-radius: .2rem
  .btn-outline-dark:not(.active)
    background: #fff
  .btn-outline-dark:not(.active):hover
    background: #343a40
  .mt-count
    margin-left: 4px
    opacity: .55
    font-size: .85em
@media(max-width: 576px)
  .mt-star-filter.fixed
    top: 150px
.mt-star-empty
  margin-top: 24px
