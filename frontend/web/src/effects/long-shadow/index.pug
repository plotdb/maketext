svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#2ec4b6")
  defs
    //- 以倍增的位移疊出 45 度長陰影: 1 + 1 + 2 + 4 + 8 + 16 = 32px
    filter#long-shadow(x="-10%",y="-10%",width="150%",height="200%")
      feOffset(in="SourceAlpha",dx="1",dy="1",result="o1")
      feMerge(result="s2")
        feMergeNode(in="SourceAlpha")
        feMergeNode(in="o1")
      feOffset(in="s2",dx="2",dy="2",result="o2")
      feMerge(result="s4")
        feMergeNode(in="s2")
        feMergeNode(in="o2")
      feOffset(in="s4",dx="4",dy="4",result="o4")
      feMerge(result="s8")
        feMergeNode(in="s4")
        feMergeNode(in="o4")
      feOffset(in="s8",dx="8",dy="8",result="o8")
      feMerge(result="s16")
        feMergeNode(in="s8")
        feMergeNode(in="o8")
      feOffset(in="s16",dx="16",dy="16",result="o16")
      feMerge(result="s32")
        feMergeNode(in="s16")
        feMergeNode(in="o16")
      feFlood(flood-color="#1a7d74",result="shadow-color")
      feComposite(operator="in",in="shadow-color",in2="s32",result="shadow")
      feMerge
        feMergeNode(in="shadow")
        feMergeNode(in="SourceGraphic")
  text(x="250",y="68",fill="#ffffff",filter="url(#long-shadow)") Hello World!
