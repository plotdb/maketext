svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#0d0d0d")
  defs
    //- 圓點遮罩
    pattern#led-dots(width="5",height="5",patternUnits="userSpaceOnUse")
      circle(cx="2.5",cy="2.5",r="1.9",fill="#ffffff")
    mask#led-mask(maskContentUnits="userSpaceOnUse")
      rect(x="-5000",y="-5000",width="10000",height="10000",fill="url(#led-dots)")
    filter#led(x="-20%",y="-50%",width="140%",height="200%")
      feGaussianBlur(in="SourceGraphic",stdDeviation="3",result="glow")
      feMerge
        feMergeNode(in="glow")
        feMergeNode(in="glow")
        feMergeNode(in="SourceGraphic")
  g(filter="url(#led)")
    text(x="250",y="75",fill="#ff9f1c",mask="url(#led-mask)") Hello World!
