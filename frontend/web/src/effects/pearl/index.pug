svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#2c2f4a")
  defs
    filter#pearl(x="-15%",y="-40%",width="130%",height="180%")
      feGaussianBlur(in="SourceAlpha",stdDeviation="3",result="height")
      //- 兩道不同顏色、不同方向的光, 珍珠的光澤
      feSpecularLighting(in="height",surfaceScale="5",specularConstant="0.9",specularExponent="12",lighting-color="#ffb3d9",result="pink")
        fePointLight(x="60",y="-60",z="120")
      feSpecularLighting(in="height",surfaceScale="5",specularConstant="0.8",specularExponent="12",lighting-color="#a8d8ff",result="blue")
        fePointLight(x="440",y="200",z="120")
      feSpecularLighting(in="height",surfaceScale="5",specularConstant="1",specularExponent="40",lighting-color="#ffffff",result="white")
        fePointLight(x="250",y="-40",z="200")
      feComposite(in="pink",in2="blue",operator="arithmetic",k2="1",k3="1",result="pb")
      feComposite(in="pb",in2="white",operator="arithmetic",k2="0.7",k3="1",result="lights")
      feComposite(in="lights",in2="SourceAlpha",operator="in",result="lustre")
      feGaussianBlur(in="SourceAlpha",stdDeviation="4",result="shadow-blur")
      feOffset(in="shadow-blur",dy="5",result="shadow-shape")
      feFlood(flood-color="#000000",flood-opacity="0.45",result="shadow-color")
      feComposite(in="shadow-color",in2="shadow-shape",operator="in",result="shadow")
      feMerge
        feMergeNode(in="shadow")
        feMergeNode(in="SourceGraphic")
        feMergeNode(in="lustre")
  text(x="250",y="75",fill="#f3eee8",stroke="#f3eee8",stroke-width="2",stroke-linejoin="round",filter="url(#pearl)") Hello World!
