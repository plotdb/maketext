svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#3a2e24")
  defs
    filter#moss(x="-15%",y="-40%",width="130%",height="180%")
      //- 高頻雜訊推動邊緣, 成為毛茸茸的輪廓
      feTurbulence(type="fractalNoise",baseFrequency="0.9",numOctaves="2",seed="6",result="noise")
      feDisplacementMap(in="SourceGraphic",in2="noise",scale="7",xChannelSelector="R",yChannelSelector="G",result="fuzzy")
      //- 明暗不一的綠
      feTurbulence(type="fractalNoise",baseFrequency="0.35",numOctaves="3",seed="9",result="clumps")
      feDiffuseLighting(in="clumps",surfaceScale="3",diffuseConstant="1.2",lighting-color="#ffffff",result="light")
        feDistantLight(azimuth="235",elevation="45")
      feComposite(in="fuzzy",in2="light",operator="arithmetic",k1="1.3",result="lit")
      feComposite(in="lit",in2="fuzzy",operator="in",result="moss")
      feGaussianBlur(in="SourceAlpha",stdDeviation="3",result="shadow-blur")
      feOffset(in="shadow-blur",dy="3",result="shadow-shape")
      feFlood(flood-color="#000000",flood-opacity="0.5",result="shadow-color")
      feComposite(in="shadow-color",in2="shadow-shape",operator="in",result="shadow")
      feMerge
        feMergeNode(in="shadow")
        feMergeNode(in="moss")
  text(x="250",y="75",fill="#5a9a2e",filter="url(#moss)") Hello World!
