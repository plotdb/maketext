svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#fde2e4")
  defs
    filter#fuzzy(x="-15%",y="-40%",width="130%",height="180%")
      //- 很細的雜訊扭曲邊緣成絨毛, 再以模糊的形狀打柔和的光
      feTurbulence(type="fractalNoise",baseFrequency="0.9",numOctaves="2",seed="1",result="noise")
      feDisplacementMap(in="SourceGraphic",in2="noise",scale="9",xChannelSelector="R",yChannelSelector="G",result="fur")
      feGaussianBlur(in="SourceAlpha",stdDeviation="4",result="blur")
      feDiffuseLighting(in="blur",surfaceScale="3",diffuseConstant="1.1",lighting-color="#ffffff",result="light")
        feDistantLight(azimuth="235",elevation="55")
      feComposite(in="fur",in2="light",operator="arithmetic",k1="1.1",result="lit")
      feGaussianBlur(in="fur",stdDeviation="3",result="shadow-blur")
      feOffset(in="shadow-blur",dy="4",result="shadow-shape")
      feFlood(flood-color="#000000",flood-opacity="0.2",result="shadow-color")
      feComposite(in="shadow-color",in2="shadow-shape",operator="in",result="shadow")
      feMerge
        feMergeNode(in="shadow")
        feMergeNode(in="lit")
  text(x="250",y="75",fill="#8e7dff",filter="url(#fuzzy)") Hello World!
