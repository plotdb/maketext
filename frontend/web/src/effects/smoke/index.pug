svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#121212")
  defs
    filter#smoke(x="-20%",y="-120%",width="140%",height="260%")
      //- 模糊往上飄, 以拉長的雜訊扭成煙
      feTurbulence(type="fractalNoise",baseFrequency="0.01 0.03",numOctaves="4",seed="17",result="noise")
      feGaussianBlur(in="SourceAlpha",stdDeviation="6",result="blur")
      feOffset(in="blur",dy="-24",result="rise")
      feDisplacementMap(in="rise",in2="noise",scale="90",xChannelSelector="R",yChannelSelector="G",result="wisp")
      feGaussianBlur(in="wisp",stdDeviation="1.5",result="wisp-soft")
      feFlood(flood-color="#cfcfcf",flood-opacity="0.85",result="smoke-color")
      feComposite(in="smoke-color",in2="wisp-soft",operator="in",result="smoke")
      feDisplacementMap(in="SourceGraphic",in2="noise",scale="6",xChannelSelector="R",yChannelSelector="G",result="face")
      feMerge
        feMergeNode(in="smoke")
        feMergeNode(in="face")
  text(x="250",y="85",fill="#f1f1f1",filter="url(#smoke)") Hello World!
