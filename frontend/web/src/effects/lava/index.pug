svg(xmlns="http://www.w3.org/2000/svg",viewBox="0 0 500 150",style="background:#140806")
  defs
    filter#lava(x="-20%",y="-50%",width="140%",height="200%")
      //- 雜訊對應成岩漿的色階: 暗紅 -> 橘 -> 黃
      feTurbulence(type="fractalNoise",baseFrequency="0.035",numOctaves="4",seed="13",result="noise")
      feColorMatrix(in="noise",type="matrix",values="2.2 0 0 0 -0.6  2.2 0 0 0 -0.6  2.2 0 0 0 -0.6  0 0 0 0 1",result="gray")
      feComponentTransfer(in="gray",result="magma")
        feFuncR(type="table",tableValues="0.18 0.6 1 1 1")
        feFuncG(type="table",tableValues="0.02 0.05 0.3 0.7 0.95")
        feFuncB(type="table",tableValues="0 0 0 0.1 0.6")
      feComposite(in="magma",in2="SourceAlpha",operator="in",result="rock")
      feGaussianBlur(in="SourceAlpha",stdDeviation="9",result="halo-blur")
      feFlood(flood-color="#ff5a00",flood-opacity="0.8",result="halo-color")
      feComposite(in="halo-color",in2="halo-blur",operator="in",result="halo")
      feGaussianBlur(in="SourceAlpha",stdDeviation="2.5",result="core-blur")
      feFlood(flood-color="#ffb000",flood-opacity="0.8",result="core-color")
      feComposite(in="core-color",in2="core-blur",operator="in",result="core")
      feMerge
        feMergeNode(in="halo")
        feMergeNode(in="core")
        feMergeNode(in="rock")
  text(x="250",y="75",fill="#000000",filter="url(#lava)") Hello World!
