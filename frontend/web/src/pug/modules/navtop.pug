//- module
+scope("@servebase/navtop").position-fixed.w-100.z-fixed(styl="top:0")
  .navtop(ld="root",data-classes="nav-dark;nav-light",data-pivot="#pivot")
    .py-2.px-4.d-flex.align-items-center
      a.d-flex.align-items-center.text-reset.text-decoration-none(href="/",title="maketext.io")
        img(src="/assets/img/favicon.png",alt="maketext.io",style="width:28px;height:28px")
        span.ml-2.font-weight-bold maketext.io
      .flex-grow-1
      .btn-group.dropdown.mr-4
        .btn.btn-sm.btn-outline-dark(ld="lng") EN
        .btn.btn-sm.btn-outline-dark.dropdown-toggle(data-toggle="dropdown"): +i.i-globe
        .dropdown-menu.dropdown-menu-right
          .dropdown-item(ld="set-lng",data-name="en") EN
          .dropdown-item(ld="set-lng",data-name="zh-TW") 中
      .d-none(ld="unauthed")
        .btn.btn-text(ld="t login") login
        .btn.btn-text(ld="t signup") signup
      .dropdown.d-none(ld="authed")
        .btn.btn-text.dropdown-toggle(data-toggle="dropdown") #[span(ld="avatar")]
        .dropdown-menu.dropdown-menu-right
          .dropdown-item(ld="displayname")
          .dropdown-divider
          a.dropdown-item(ld="t", href="/me/settings") settings
          .dropdown-divider
          .dropdown-item.text-danger(ld="t logout") logout
