//- module
include @/@xlfont/choose/index.pug

//- 字型選擇器的標記, 第一次打開時複製進遮罩 ( src/ls/editor/font.ls )
template#mt-xfc-tpl: .mt-xfc-panel: +xfc

//- 色盤選擇器 ( ldpalettepicker ), 由 src/ls/editor/palette.ls 建立
include @/ldpalettepicker/ldpp.pug
#palette-picker.ldcv.default-size: .base: .inner.ldpp: +ldpp

//- 圖樣填色的選單 ( src/ls/editor/pattern.ls )
#pattern-picker.ldcv: .base: .inner
  .p-4
    h5.mb-1 Pattern Fill
    .small.text-muted.mb-3 fill the text with an animated pattern. download as GIF to keep the animation.
    .mt-pattern-grid
    .mt-3.d-flex.align-items-center
      label.btn.btn-sm.btn-outline-dark.mb-0
        | upload a GIF ...
        input.d-none(type="file",accept="image/gif,image/png,image/jpeg,image/webp")
      div(style="flex:1 1 auto")
      .btn.btn-sm.btn-outline-secondary(data-ldcv-set="") close

#download.modal
  .card
    .card-body
      h4 Generated Image
      small.gray click the download button to download
      .result: img
      hr
      a.btn.btn-lg.btn-outline-success.mr-2(href="#",download="") Download
      .btn.btn-lg.btn-outline-secondary(onclick="$('#download').modal('hide')") Close

#editor-option-sample(style="display:none")
  #editor-option-sample-color.col-sm.col-4
    label Color
    +color-input('color')
  #editor-option-sample-number.col-sm.col-4
    label Number
    +slider

#editor
  .config
    .row(style="max-width:1024px;margin:auto")
      .col-6.col-sm-3
        label Text
        input#text-input.form-control.form-control-sm(value="Hello World!")
      .col-6.col-sm-3
        label Font
        //- 選的字型套用到所有效果; 還原: 回到各效果自己的預設字型 ( src/ls/editor/font.ls )
        .d-flex
          .btn.btn-sm.btn-outline-dark.text-truncate(onclick="chooseFont()",style="flex:1 1 auto;min-width:0"): span#font-name Choose ...
          .btn.btn-sm.btn-outline-dark.ml-1.d-none#font-reset(onclick="resetFont()",title="use each effect's own font") &#x21ba;
      #font-size-slider.col-4.col-sm-3
        label Font Size
        +slider
      .col-4.col-sm-3
        label Background
        +color-input('background')
      #palette-btn.col-sm-3.col-4.adv
        label Palette
        .palette(onclick="pickPalette()")
          each i in ['#f00','#0f0','#00f','#0ff']
            .color(style="background:" + i)
      #editor-custom-options.col-12.col-sm-9.row.adv(style="margin-left:0;padding:0")
  br
  #cooltext
  .footer.text-center
    //- 匯出範圍 ( 文字外框加 padding, 預覽上的虛線框 ) 與倍率, 見 src/ls/editor/layout.ls
    .inline-block.text-left.mr-2.mt-export-opt
      label Padding
      input#export-padding.form-control(type="number",min="0",max="300",step="1")
    .inline-block.text-left.mr-2.mt-export-opt
      label Scale
      select#export-scale.form-control
        option(value="1") 1x
        option(value="2") 2x
        option(value="3") 3x
    .inline-block.text-left
      label Download As ...
      .block.mr-2(style="display:inline-block;width:300px")
        // NOTE: editor-download-btn will be queried with API users
        //- 點陣格式由 dropup 選 ( 預設 PNG ), 見 src/ls/editor/download.ls 的 raster
        #editor-download-btn.btn-group.dropup
          .btn.btn-outline-dark(data-type="svg", onclick="convert.svg()") SVG
          .btn.btn-outline-dark(data-type="png", onclick="convert.png()") PNG
          .btn.btn-outline-dark.dropdown-toggle.dropdown-toggle-split(data-toggle="dropdown",style="flex-grow:0")
          .dropdown-menu.dropdown-menu-right
            each f in ["png", "jpg", "webp", "gif"]
              a.dropdown-item(href="#",data-type=f,onclick="convert.raster('" + f + "');return false")= f.toUpperCase()
    .inline-block
      //- 拖曳過文字時出現: 回到原本的位置
      .btn.btn-outline-dark.mr-2.d-none#editor-reset-offset(onclick="mtFrame.reset()",title="reset text position") &#x21ba; Position
      .btn.btn-outline-dark.mr-2(onclick="editor.toggle(false)") #[big(style="line-height:1em") &times;] Close
    .mt-drag-hint drag the text to adjust its position
