//- module
//- nbr 由 @loadingio/bootstrap.ext 提供
mixin slider(size)
  - if(!size) size = "sm"
  .up.irs-input: input.form-control(class="form-control-" + size, default-switch="false")

mixin color-input(name,size)
  - if(!size) size = "sm"
  .color
    input.form-control(class="form-control-" + size,
    name=name,value="#f0f0f0",data-classname="no-button compact-palette flat",
    data-toggle="colorpicker",data-context="random",data-exclusive="true")
    .inner

//- X ( 舊 twitter ) 的圖示. font awesome 4.7 沒有
mixin x-icon
  svg.mt-x-icon(viewBox="0 0 24 24",width="0.9em",height="0.9em"): path(fill="currentColor",d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z")
