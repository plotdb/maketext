//- module
#footer
  .row
    .col-sm.mb-4
      //- 年份由下方 script 更新為今年 ( 頁面是預先 build 的靜態檔 )
      h1 Maketext.io#[span(style="vertical-align:top;font-size:14px") &copy; 2018 ~ #[span.mt-year 2026]]
      .sep
      p Super fast, vector-based cool text generator powered by modern web technologies.
      p.small #[a.mt-footer-link(href="/tos") Term of Use] #[span.mx-1 /] #[a.mt-footer-link(href="/privacy") Privacy Policy] #[span.mx-1 /] #[a.mt-footer-link(href="mailto:contact@maketext.io") Contact]
      .row
        .col-sm
          a.btn.btn-block.btn-outline-light.mr-2.mb-2(href="https://www.facebook.com/sharer/sharer.php?u=https://maketext.io",target="_blank") share with facebook #[i.fa.fa-facebook]
        .col-sm
          a.btn.btn-block.btn-outline-light.text-nowrap(href="https://x.com/intent/post?url=https://maketext.io&text=super-fast%20cool%20text%20generator%20for%20modern%20age",target="_blank") share with #[+x-icon]
        .col-sm

    .col-sm
      h1: small Partner Sites
      .sep
      .mb-2
        a(href="https://loading.io") #[i.fa.fa-external-link] loading.io #[img(src="/assets/img/loader/cloudy.gif")]
        .ml-3 animated icons and spinner service
      //- makeweb.io 已停止服務, 先隱藏
      .mb-2.d-none
        a(href="https://makeweb.io") #[i.fa.fa-external-link] makeweb.io #[img(src="/assets/img/landing/makeweb.png")]
        .ml-3 real-time collaborative web design service
      .mb-2
        a(href="https://makechart.io") #[i.fa.fa-external-link] makechart.io #[img(src="/assets/img/landing/rose.png")]
        .ml-3 make chart online for free

  +nbr(2)
script.
  Array.from(document.querySelectorAll('.mt-year')).map(function(n) { n.textContent = new Date().getFullYear(); });
