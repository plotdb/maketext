//- view
//- 單一效果的獨立頁 /effect/<name>/ ( backend/maketext/index.ls ).
//- locals: effect ( static/js/effects/meta.json 的一筆: key, label, desc, tags, font )
extends /modules/mt/base.pug
block vars
  -
    title = effect.label + " Text Effect #" + effect.no + " - Free Online Generator in SVG / PNG · maketext.io";
    description = (effect.desc ? effect.desc + " " : "") + "Make " + effect.label.toLowerCase() + " text effect online, customize colors and fonts, and download it as SVG, PNG, JPG, WEBP or GIF.";
    url = "https://maketext.io/effect/" + effect.key + "/";
    //- 有自己網址的效果 ( effect.yaml 的 page )
    if (effect.key == "font-to-svg") {
      title = "Font to SVG Converter - Turn Text into SVG Paths with 800+ Fonts · maketext.io";
      description = "Convert text in any of 800+ free fonts into SVG paths online. Pick a font, type your text and download an SVG ( or transparent PNG ) with an optional outline, ready for Figma, Illustrator, Cricut or the web.";
    }
    if (effect.page) { url = "https://maketext.io" + effect.page; }
    thumbnail = "https://maketext.io/assets/og/" + effect.key + ".jpg";
    thumb = {type: "image/jpeg", width: "1200", height: "630"};
block body
  - var isApi = false
  include /modules/mt/landing.pug
  +nbr(5)
  include /modules/mt/footer.pug
block script
  +script([
    "/js/editor/util.js",
    "/js/editor/index.js",
    "/js/editor/palette.js",
    "/js/editor/font.js",
    "/js/editor/layout.js",
    "/js/editor/pattern.js",
    "/js/editor/share.js",
    "/js/editor/download.js",
    "/js/editor/star.js"
  ], {pack: true})
